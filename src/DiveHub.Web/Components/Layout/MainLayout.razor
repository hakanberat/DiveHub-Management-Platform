
@inherits LayoutComponentBase
@inject IHttpContextAccessor RequestContext

<div class="app-shell">

    <header class="topbar">
        <div class="container nav-inner">

            
<a class="brand" href="/" aria-label="Dive Hub Home">
    <img src="/images/divehub-logo.png"
         alt="Dive Hub Logo"
         class="brand-logo" />

    <span class="brand-text">
        DIVE <strong>HUB</strong>
    </span>
</a>


            <nav class="nav-links">
                <a href="/">Home</a>
                <a href="/dive-sites">Dive Sites</a>
                <a href="/team">Our Team</a>
                <a href="/activities/diving">Diving Activities</a>
                <a href="/activities/courses"> Courses</a>

                @if (RequestContext.HttpContext?.User
                    .IsInRole("Admin") == true)
                {
                    <a class="nav-admin" href="/admin">
                        Admin
                    </a>

                    <form method="post" action="/account/logout">
                        <CsrfField />

                        <button class="nav-logout" type="submit">
                            Sign Out
                        </button>
                    </form>
                }
                else
                {
                    <a class="nav-admin" href="/login">
                        Sign In
                    </a>
                }
            </nav>

        </div>
    </header>

    <main class="main-content">
        @Body
    </main>

    <footer class="footer">
        <div class="container footer-inner">

            <span>
                &copy; @DateTime.UtcNow.Year Dive Hub
            </span>

            <span>
                Dive Center Management Platform
            </span>

        </div>
    </footer>

</div>

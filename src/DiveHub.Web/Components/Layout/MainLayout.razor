@inherits LayoutComponentBase

@inject IHttpContextAccessor RequestContext

<div class="app-shell">

    <header class="topbar">

        <div class="container nav-inner">

            <a class="brand"
               href="/"
               aria-label="Dive Hub Home">

                <img src="/images/divehub-logo.png"
                     alt="Dive Hub Logo"
                     class="brand-logo" />

                <span class="brand-text">
                    DIVE <strong>HUB</strong>
                </span>

            </a>

            <nav class="nav-links"
                 aria-label="Main navigation">

                <a href="/">Home</a>

                <a href="/dive-sites">
                    Dive Sites
                </a>

                <a href="/team">
                    Our Team
                </a>

                <a href="/activities/diving">
                    Diving Activities
                </a>

                <a href="/activities/courses">
                    Courses
                </a>

                @if (RequestContext.HttpContext?.User
                    .Identity?.IsAuthenticated == true)
                {
                    @if (RequestContext.HttpContext.User
                        .IsInRole("Admin"))
                    {
                        <a class="nav-admin"
                           href="/admin">
                            Admin
                        </a>
                    }

                    @if (RequestContext.HttpContext.User
                        .IsInRole("Customer"))
                    {
                        <a href="/account">
                            My Account
                        </a>

                        <a href="/my-reservations">
                            My Reservations
                        </a>

                        <a href="/book">
                            Book
                        </a>
                    }

                    <form method="post"
                          action="/account/logout">

                        <CsrfField />

                        <button class="nav-logout"
                                type="submit">
                            Sign Out
                        </button>

                    </form>
                }
                else
                {
                    <a href="/customer/login">
                        Sign In
                    </a>

                    <a href="/customer/register">
                        Register
                    </a>

                    <a class="nav-admin"
                       href="/login">
                        Admin
                    </a>
                }

            </nav>

        </div>

    </header>

    <main class="main-content">
        @Body
    </main>

    <footer class="footer">

        <div class="container footer-inner">

            <span>
                &copy; @DateTime.UtcNow.Year Dive Hub
            </span>

            <span>
                Dive Center Management Platform
            </span>

        </div>

    </footer>

</div>
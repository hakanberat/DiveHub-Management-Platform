
@page "/my-reservations"

@attribute [Authorize]

@using System.Globalization
@using DiveHub.Domain
@using DiveHub.Web.Services
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authorization

@inject IHttpContextAccessor RequestContext
@inject CustomerBookingApiClient BookingApi

<PageTitle>My Reservations | Dive Hub</PageTitle>

<section class="booking-page">
    <div class="container">

        <div class="booking-heading">
            <span class="eyebrow dark">
                CUSTOMER ACCOUNT
            </span>

            <h1>My Reservations</h1>

            <p>
                Track your diving activities,
                training courses and booking status.
            </p>

            <a href="/book" class="btn btn-primary">
                New Booking
            </a>
        </div>

        @if (Status == "created")
        {
            <div class="notice success">
                Your booking request has been submitted successfully.
                Its current status is Pending.
            </div>
        }

        @if (LoadError)
        {
            <div class="notice error">
                Your reservations could not be loaded.
                Check your session or API connection.
            </div>
        }
        else if (Reservations.Count == 0)
        {
            <div class="booking-card">
                <div class="empty-state">
                    <h2>No reservations yet</h2>

                    <p>
                        You have not submitted any
                        diving or training requests.
                    </p>

                    <a href="/book" class="btn btn-primary">
                        Book Your First Experience
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="reservation-list">

                @foreach (var reservation in Reservations)
                {
                    <article class="reservation-card">

                        <div class="reservation-card-header">
                            <div>
                                <span class="reservation-number">
                                    Booking #@reservation.Id
                                </span>

                                <h2>@reservation.ActivityName</h2>

                                <p class="reservation-customer">
                                    Requested
                                    @reservation.CreatedAtUtc.ToString(
                                        "dd MMM yyyy",
                                        CultureInfo.InvariantCulture)
                                    (UTC)
                                </p>
                            </div>

                            <span class="@GetStatusClass(reservation.Status)">
                                @reservation.Status
                            </span>
                        </div>

                        <div class="reservation-details">

                            <div>
                                <span>Activity Date</span>

                                <strong>
                                    @reservation.ActivityDate.ToString(
                                        "dd MMM yyyy",
                                        CultureInfo.InvariantCulture)
                                </strong>
                            </div>

                            <div>
                                <span>Participants</span>

                                <strong>
                                    @reservation.ParticipantCount
                                </strong>
                            </div>

                            <div>
                                <span>Total Price</span>

                                <strong>
                                    @reservation.TotalPrice.ToString(
                                        "N2",
                                        CultureInfo.InvariantCulture)
                                    @reservation.Currency
                                </strong>
                            </div>

                            <div>
                                <span>Payment</span>

                                <strong>
                                    @reservation.PaymentStatus
                                </strong>
                            </div>

                        </div>

                        @if (!string.IsNullOrWhiteSpace(
                            reservation.CustomerNotes))
                        {
                            <div class="reservation-notes">
                                <strong>Your Notes</strong>
                                <p>@reservation.CustomerNotes</p>
                            </div>
                        }

                        @if (reservation.Status == ReservationStatus.Pending)
                        {
                            <div class="booking-state-message">
                                <strong>Awaiting Confirmation</strong>
                                <p>
                                    Your request is under review.
                                    Our team will confirm
                                    resource availability.
                                </p>
                            </div>
                        }
                        else if (reservation.Status ==
                            ReservationStatus.Confirmed)
                        {
                            <div class="booking-state-message">
                                <strong>Booking Confirmed</strong>

                                <p>
                                    Your reservation has been confirmed.
                                </p>
                            </div>
                        }

                        <div class="reservation-assignments">
                            <span>
                                Boat:
                                @(reservation.BoatName ?? "Not assigned")
                            </span>

                            <span>
                                Instructor:
                                @(reservation.InstructorName ?? "Not assigned")
                            </span>
                        </div>

                    </article>
                }

            </div>
        }

    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "status")]
    public string? Status { get; set; }

    private IReadOnlyList<CustomerReservationItem> Reservations = [];

    private bool LoadError;

    protected override async Task OnParametersSetAsync()
    {
        LoadError = false;
        Reservations = [];

        var context = RequestContext.HttpContext;

        if (context is null)
        {
            LoadError = true;
            return;
        }

        var token = await context.GetTokenAsync(
            "DiveHubWeb",
            "access_token");

        if (string.IsNullOrWhiteSpace(token))
        {
            LoadError = true;
            return;
        }

        try
        {
            Reservations = await BookingApi.GetMineAsync(token);
        }
        catch (HttpRequestException)
        {
            LoadError = true;
        }
        catch (TaskCanceledException)
        {
            LoadError = true;
        }
    }

    private static string GetStatusClass(
        ReservationStatus status)
    {
        return "reservation-status status-" +
            status.ToString().ToLowerInvariant();
    }
}

@page "/admin/diving-activities"
@page "/admin/courses"

@attribute [Authorize(Roles = "Admin")]

@using System.Globalization
@using Microsoft.AspNetCore.Authentication

@inject NavigationManager Navigation
@inject IHttpContextAccessor RequestContext
@inject AdminActivityCatalogApiClient Api

<PageTitle>@PageHeading | Dive Hub</PageTitle>

<section class="admin-page">
    <div class="container">

        <div class="admin-heading">
            <div>
                <span class="eyebrow dark">
                    CONTENT MANAGEMENT
                </span>

                <h1>@PageHeading</h1>
                <p>@PageDescription</p>
            </div>

            <a href="/admin"
               class="btn btn-secondary">
                Back to Dashboard
            </a>
        </div>

        @if (Status == "saved")
        {
            <div class="notice success">
                Changes saved successfully.
            </div>
        }
        else if (Status == "invalid")
        {
            <div class="notice error">
                Invalid information. Check the fields,
                price and currency.
            </div>
        }
        else if (Status == "notfound")
        {
            <div class="notice error">
                The requested item was not found.
            </div>
        }
        else if (Status == "error")
        {
            <div class="notice error">
                Operation failed. Check the API connection.
            </div>
        }

        @if (LoadError)
        {
            <div class="notice error">
                Could not load catalog items.
                Check the API and login session.
            </div>
        }
        else
        {
            <div class="admin-grid">

                <AdminSidebar Active="@ReturnKey" />

                <div class="admin-main">

                    <div class="panel-header">
                        <h2>Create New @ItemLabel</h2>
                        <p>
                            New items are saved as drafts.
                            After creating an item, set its boat requirement
                            in the management card below before publishing.
                        </p>
                    </div>

                    <form method="post"
                          action="/admin/activity-catalog/create"
                          class="admin-form">

                        <CsrfField />

                        <input type="hidden"
                               name="Kind"
                               value="@SelectedKind" />

                        <input type="hidden"
                               name="ReturnTo"
                               value="@ReturnKey" />

                        <div class="form-field">
                            <label for="new-activity-name">
                                Name
                            </label>

                            <input id="new-activity-name"
                                   name="Name"
                                   maxlength="120"
                                   required
                                   placeholder="Enter a name" />
                        </div>

                        <div class="form-field">
                            <label for="new-activity-description">
                                Description
                            </label>

                            <textarea id="new-activity-description"
                                      name="Description"
                                      maxlength="1000"
                                      rows="5"></textarea>
                        </div>

                        <div class="form-field">
                            <label for="new-activity-price">
                                Price
                            </label>

                            <input id="new-activity-price"
                                   name="Price"
                                   type="number"
                                   min="0"
                                   max="999999.99"
                                   step="0.01"
                                   value="0.00"
                                   required />
                        </div>

                        <div class="form-field">
                            <label for="new-activity-currency">
                                Currency
                            </label>

                            <select id="new-activity-currency"
                                    name="Currency"
                                    required>

                                <option value="EUR">EUR</option>
                                <option value="USD">USD</option>
                                <option value="GBP">GBP</option>
                                <option value="TRY">TRY</option>
                            </select>
                        </div>

                        <div class="form-actions">
                            <button type="submit"
                                    class="btn btn-primary">
                                Create @ItemLabel
                            </button>
                        </div>

                    </form>
                </div>
            </div>

            <div class="section-heading"
                 style="margin-top:55px">

                <span class="eyebrow dark">
                    @PageHeading.ToUpperInvariant()
                </span>

                <h2>Manage @PageHeading</h2>
                <p>@CatalogItems.Count item(s)</p>
            </div>

            @if (CatalogItems.Count == 0)
            {
                <div class="empty-state">
                    <h2>No items yet.</h2>
                    <p>Create your first @ItemLabel above.</p>
                </div>
            }
            else
            {
                <div class="content-grid">

                    @foreach (var item in CatalogItems)
                    {
                        <article class="content-card">

                            <span class="card-label">
                                @(item.IsPublished
                                    ? "PUBLISHED"
                                    : "DRAFT")
                            </span>

                            <h2>@item.Name</h2>

                            <p class="card-meta">
                                @item.Price.ToString(
                                    "0.00",
                                    CultureInfo.InvariantCulture)
                                @item.Currency
                            </p>

                            <form method="post"
                                  action="@($"/admin/activity-catalog/{item.Id}/update")"
                                  class="admin-form">

                                <CsrfField />

                                <input type="hidden"
                                       name="Kind"
                                       value="@item.Kind" />

                                <input type="hidden"
                                       name="ReturnTo"
                                       value="@ReturnKey" />

                                <div class="form-field">
                                    <label>Name</label>

                                    <input name="Name"
                                           value="@item.Name"
                                           maxlength="120"
                                           required />
                                </div>

                                <div class="form-field">
                                    <label>Description</label>

                                    <textarea name="Description"
                                              rows="5"
                                              maxlength="1000">@item.Description</textarea>
                                </div>

                                <div class="form-field">
                                    <label>Price</label>

                                    <input name="Price"
                                           type="number"
                                           min="0"
                                           max="999999.99"
                                           step="0.01"
                                           value="@item.Price.ToString("0.00", CultureInfo.InvariantCulture)"
                                           required />
                                </div>

                                <div class="form-field">
                                    <label>Currency</label>

                                    <select name="Currency" required>
                                        @foreach (var currency in Currencies)
                                        {
                                            <option value="@currency"
                                                    selected="@(currency == item.Currency)">
                                                @currency
                                            </option>
                                        }
                                    </select>
                                </div>

                                <div class="form-actions">
                                    <button type="submit"
                                            class="btn btn-secondary">
                                        Save Changes
                                    </button>
                                </div>

                            </form>

                            <ActivityPhotoManager
                                ActivityId="@item.Id"
                                ReturnTo="@ReturnKey" />

                            <form method="post"
                                  action="@($"/admin/activity-catalog/{item.Id}/boat-requirement")"
                                  class="admin-form">

                                <CsrfField />

                                <input type="hidden"
                                       name="ReturnTo"
                                       value="@ReturnKey" />

                                <div class="form-field">
                                    <label for="@($"boat-requirement-{item.Id}")">
                                        Requires Boat
                                    </label>

                                    <select id="@($"boat-requirement-{item.Id}")"
                                            name="RequiresBoat"
                                            required>
                                        <option value="false"
                                                selected="@(!BoatRequirements.GetValueOrDefault(item.Id))">
                                            No — shore activity / boat optional
                                        </option>
                                        <option value="true"
                                                selected="@(BoatRequirements.GetValueOrDefault(item.Id))">
                                            Yes — boat required for confirmation
                                        </option>
                                    </select>
                                </div>

                                <div class="form-actions">
                                    <button type="submit"
                                            class="btn btn-secondary">
                                        Save Boat Requirement
                                    </button>
                                </div>
                            </form>

                            <div class="card-footer">

                                <form method="post"
                                      action="@($"/admin/activity-catalog/{item.Id}/publication")">

                                    <CsrfField />

                                    <input type="hidden"
                                           name="ReturnTo"
                                           value="@ReturnKey" />

                                    <input type="hidden"
                                           name="IsPublished"
                                           value="@(item.IsPublished ? "false" : "true")" />

                                    <button type="submit"
                                            class="btn btn-primary">

                                        @(item.IsPublished
                                            ? "Unpublish"
                                            : "Publish")
                                    </button>
                                </form>

                            </div>

                        </article>
                    }

                </div>
            }
        }

    </div>
</section>

@code {
    private static readonly string[] Currencies =
        ["EUR", "USD", "GBP", "TRY"];

    private IReadOnlyList<ActivityCatalogItem> CatalogItems = [];

    private Dictionary<int, bool> BoatRequirements = [];

    private bool LoadError;

    [SupplyParameterFromQuery(Name = "status")]
    public string? Status { get; set; }

    
    private bool IsCoursePage =>
    string.Equals(
        Navigation.ToAbsoluteUri(Navigation.Uri).AbsolutePath.TrimEnd('/'),
        "/admin/courses",
        StringComparison.OrdinalIgnoreCase);


    private ActivityKind SelectedKind =>
        IsCoursePage
            ? ActivityKind.Course
            : ActivityKind.Dive;

    private string ReturnKey =>
        IsCoursePage
            ? "courses"
            : "diving-activities";

    private string PageHeading =>
        IsCoursePage
            ? "Courses"
            : "Diving Activities";

    private string ItemLabel =>
        IsCoursePage
            ? "Course"
            : "Diving Activity";

    private string PageDescription =>
        IsCoursePage
            ? "Manage training courses, prices and photos."
            : "Manage diving experiences, prices and photos.";

    protected override async Task OnParametersSetAsync()
    {
        LoadError = false;
        CatalogItems = [];
        BoatRequirements = [];

        var context = RequestContext.HttpContext;

        if (context is null)
        {
            LoadError = true;
            return;
        }

        var token = await context.GetTokenAsync(
            "DiveHubWeb", "access_token");

        if (string.IsNullOrWhiteSpace(token))
        {
            LoadError = true;
            return;
        }

        try
        {
            var allItems = await Api.ListAsync(token);
            var requirements = await Api.GetBoatRequirementsAsync(token);
            BoatRequirements = requirements.ToDictionary(
                x => x.ActivityId,
                x => x.RequiresBoat);

            CatalogItems = allItems
                .Where(x => x.Kind == SelectedKind)
                .OrderBy(x => x.Name)
                .ToList();
        }
        catch (HttpRequestException)
        {
            LoadError = true;
        }
        catch (TaskCanceledException)
        {
            LoadError = true;
        }
    }
}

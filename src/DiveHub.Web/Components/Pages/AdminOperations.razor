
@page "/admin/boats"
@page "/admin/instructors"

@attribute [Authorize(Roles = "Admin")]

@using Microsoft.AspNetCore.Authentication

@inject NavigationManager Navigation
@inject IHttpContextAccessor RequestContext
@inject OperationsCatalogApiClient Api

<PageTitle>@PageHeading | Dive Hub</PageTitle>

<section class="admin-page">
    <div class="container">

        <div class="admin-heading">
            <div>
                <span class="eyebrow dark">
                    OPERATIONS MANAGEMENT
                </span>

                <h1>@PageHeading</h1>

                <p>
                    @(IsBoatPage
                        ? "Manage your fleet and boat capacities."
                        : "Manage your diving team and instructor profiles.")
                </p>
            </div>

            <a class="btn btn-secondary" href="/admin">
                Back to Dashboard
            </a>
        </div>

        @if (Status == "saved")
        {
            <div class="notice success">
                Changes saved successfully.
            </div>
        }
        else if (Status == "invalid")
        {
            <div class="notice error">
                Invalid information. Check the form fields.
            </div>
        }
        else if (Status == "notfound")
        {
            <div class="notice error">
                The requested record was not found.
            </div>
        }
        else if (Status == "error")
        {
            <div class="notice error">
                Operation failed. Check the API connection.
            </div>
        }

        @if (LoadError)
        {
            <div class="notice error">
                Could not load records.
                Check your login session and API.
            </div>
        }
        else
        {
            <div class="admin-grid">

                <AdminSidebar Active="@(IsBoatPage ? "boats" : "instructors")" />

                <div class="admin-main">

                    @if (IsBoatPage)
                    {
                        <!-- BOATS PAGE -->

                        <section id="boats">

                            <div class="panel-header">
                                <h2>Fleet Management</h2>
                                <p>
                                    @BoatItems.Count registered boat(s).
                                </p>
                            </div>

                            <div class="operations-grid">

                                <div class="operations-card">

                                    <h3>Add New Boat</h3>

                                    <form method="post"
                                          action="/admin/operations/boats/create"
                                          class="admin-form">

                                        <CsrfField />

                                        <div class="form-field">
                                            <label for="boat-name">
                                                Boat Name
                                            </label>

                                            <input id="boat-name"
                                                   name="Name"
                                                   maxlength="100"
                                                   required />
                                        </div>

                                        <div class="form-field">
                                            <label for="boat-capacity">
                                                Passenger Capacity
                                            </label>

                                            <input id="boat-capacity"
                                                   name="Capacity"
                                                   type="number"
                                                   min="1"
                                                   max="250"
                                                   required />
                                        </div>

                                        <button class="btn btn-primary"
                                                type="submit">
                                            Add Boat
                                        </button>

                                    </form>
                                </div>

                                @foreach (var boat in BoatItems)
                                {
                                    <div class="operations-card">

                                        <span class="card-label">
                                            @(boat.IsActive
                                                ? "ACTIVE"
                                                : "INACTIVE")
                                        </span>

                                        <h3>@boat.Name</h3>

                                        <form method="post"
                                              action="@($"/admin/operations/boats/{boat.Id}/update")"
                                              class="admin-form">

                                            <CsrfField />

                                            <div class="form-field">
                                                <label>Boat Name</label>

                                                <input name="Name"
                                                       value="@boat.Name"
                                                       maxlength="100"
                                                       required />
                                            </div>

                                            <div class="form-field">
                                                <label>Capacity</label>

                                                <input name="Capacity"
                                                       value="@boat.Capacity"
                                                       type="number"
                                                       min="1"
                                                       max="250"
                                                       required />
                                            </div>

                                            <button class="btn btn-secondary"
                                                    type="submit">
                                                Save Changes
                                            </button>
                                        </form>

                                        <form method="post"
                                              action="@($"/admin/operations/boats/{boat.Id}/active")"
                                              class="operations-action-form">

                                            <CsrfField />

                                            <input type="hidden"
                                                   name="IsActive"
                                                   value="@(boat.IsActive ? "false" : "true")" />

                                            <button class="btn btn-primary"
                                                    type="submit">
                                                @(boat.IsActive
                                                    ? "Deactivate Boat"
                                                    : "Activate Boat")
                                            </button>

                                        </form>

                                    </div>
                                }

                            </div>

                        </section>
                    }
                    else
                    {
                        <!-- INSTRUCTORS PAGE -->

                        <section id="instructors">

                            <div class="panel-header">
                                <h2>Instructor Management</h2>
                                <p>
                                    @InstructorItems.Count instructor profile(s).
                                </p>
                            </div>

                            <div class="operations-grid">

                                <div class="operations-card">

                                    <h3>Add New Instructor</h3>

                                    <form method="post"
                                          action="/admin/operations/instructors/create"
                                          class="admin-form">

                                        <CsrfField />

                                        <div class="form-field">
                                            <label for="instructor-name">
                                                Full Name
                                            </label>

                                            <input id="instructor-name"
                                                   name="FullName"
                                                   maxlength="120"
                                                   required />
                                        </div>

                                        <div class="form-field">
                                            <label for="instructor-agency">
                                                Certification Agency
                                            </label>

                                            <input id="instructor-agency"
                                                   name="CertificationAgency"
                                                   maxlength="100"
                                                   placeholder="e.g. PADI" />
                                        </div>

                                        <div class="form-field">
                                            <label for="instructor-number">
                                                Certification Number
                                            </label>

                                            <input id="instructor-number"
                                                   name="CertificationNumber"
                                                   maxlength="100" />
                                        </div>

                                        <div class="form-field">
                                            <label for="instructor-bio">
                                                Biography
                                            </label>

                                            <textarea id="instructor-bio"
                                                      name="Biography"
                                                      maxlength="1500"
                                                      rows="5"></textarea>
                                        </div>

                                        <button class="btn btn-primary"
                                                type="submit">
                                            Add Instructor
                                        </button>
                                    </form>

                                </div>

                                @foreach (var instructor in InstructorItems)
                                {
                                    <div class="operations-card">

                                        <span class="card-label">
                                            @(instructor.IsActive
                                                ? "ACTIVE"
                                                : "INACTIVE")
                                            /
                                            @(instructor.IsPublished
                                                ? "PUBLISHED"
                                                : "DRAFT")
                                        </span>

                                        <h3>@instructor.FullName</h3>

                                        <form method="post"
                                              action="@($"/admin/operations/instructors/{instructor.Id}/update")"
                                              class="admin-form">

                                            <CsrfField />

                                            <div class="form-field">
                                                <label>Full Name</label>

                                                <input name="FullName"
                                                       value="@instructor.FullName"
                                                       maxlength="120"
                                                       required />
                                            </div>

                                            <div class="form-field">
                                                <label>Certification Agency</label>

                                                <input name="CertificationAgency"
                                                       value="@instructor.CertificationAgency"
                                                       maxlength="100" />
                                            </div>

                                            <div class="form-field">
                                                <label>Certification Number</label>

                                                <input name="CertificationNumber"
                                                       value="@instructor.CertificationNumber"
                                                       maxlength="100" />
                                            </div>

                                            <div class="form-field">
                                                <label>Biography</label>

                                                <textarea name="Biography"
                                                          maxlength="1500"
                                                          rows="5">@instructor.Biography</textarea>
                                            </div>

                                            <button class="btn btn-secondary"
                                                    type="submit">
                                                Save Changes
                                            </button>

                                        </form>

                                        <InstructorPhotoManager
                                            InstructorId="@instructor.Id" />

                                        <div class="operations-actions">

                                            <form method="post"
                                                  action="@($"/admin/operations/instructors/{instructor.Id}/active")">

                                                <CsrfField />

                                                <input type="hidden"
                                                       name="IsActive"
                                                       value="@(instructor.IsActive ? "false" : "true")" />

                                                <button class="btn btn-secondary"
                                                        type="submit">
                                                    @(instructor.IsActive
                                                        ? "Deactivate"
                                                        : "Activate")
                                                </button>
                                            </form>

                                            <form method="post"
                                                  action="@($"/admin/operations/instructors/{instructor.Id}/publication")">

                                                <CsrfField />

                                                <input type="hidden"
                                                       name="IsPublished"
                                                       value="@(instructor.IsPublished ? "false" : "true")" />

                                                <button class="btn btn-primary"
                                                        type="submit">
                                                    @(instructor.IsPublished
                                                        ? "Unpublish"
                                                        : "Publish")
                                                </button>
                                            </form>

                                        </div>

                                    </div>
                                }

                            </div>

                        </section>
                    }

                </div>
            </div>
        }

    </div>
</section>

@code {
    private IReadOnlyList<BoatItem> BoatItems = [];

    private IReadOnlyList<InstructorItem> InstructorItems = [];

    private bool LoadError;

    [SupplyParameterFromQuery(Name = "status")]
    public string? Status { get; set; }

    
    private bool IsBoatPage =>
    string.Equals(
        Navigation.ToAbsoluteUri(Navigation.Uri).AbsolutePath.TrimEnd('/'),
        "/admin/boats",
        StringComparison.OrdinalIgnoreCase);


    private string PageHeading =>
        IsBoatPage ? "Boats" : "Instructors";

    protected override async Task OnParametersSetAsync()
    {
        LoadError = false;
        BoatItems = [];
        InstructorItems = [];

        var context = RequestContext.HttpContext;

        if (context is null)
        {
            LoadError = true;
            return;
        }

        var token = await context.GetTokenAsync(
            "DiveHubWeb", "access_token");

        if (string.IsNullOrWhiteSpace(token))
        {
            LoadError = true;
            return;
        }

        try
        {
            if (IsBoatPage)
            {
                BoatItems = await Api.GetBoatsAsync(token);
            }
            else
            {
                InstructorItems =
                    await Api.GetInstructorsAsync(token);
            }
        }
        catch (HttpRequestException)
        {
            LoadError = true;
        }
        catch (TaskCanceledException)
        {
            LoadError = true;
        }
    }
}

@using System.Globalization

<div class="form-field">
    <label>Name *</label>
    <input name="Name"
           value="@Item?.Name"
           maxlength="120"
           required />
</div>

<div class="form-field">
    <label>Category</label>
    <input name="Category"
           value="@Item?.Category"
           maxlength="100"
           placeholder="Boat Diving, Beginner, Specialty..." />
</div>

<div class="form-field">
    <label>Short Description</label>
    <textarea name="ShortDescription"
              maxlength="300"
              rows="3">@(Item?.ShortDescription ?? "")</textarea>
</div>

<div class="form-field">
    <label>Full Description</label>
    <textarea name="Description"
              maxlength="4000"
              rows="6">@(Item?.Description ?? "")</textarea>
</div>

<h3>Location</h3>

<div class="form-field">
    <label>Country</label>
    <input name="Country"
           value="@Item?.Country"
           maxlength="100" />
</div>

<div class="form-field">
    <label>City</label>
    <input name="City"
           value="@Item?.City"
           maxlength="100" />
</div>

<div class="form-field">
    <label>Location</label>
    <input name="Location"
           value="@Item?.Location"
           maxlength="250" />
</div>

<div class="form-field">
    <label>Map URL</label>
    <input name="MapLocation"
           type="url"
           value="@Item?.MapLocation"
           maxlength="2000"
           placeholder="https://maps.google.com/..." />
</div>

<h3>Pricing</h3>

<div class="form-field">
    <label>Price per Participant *</label>
    <input name="Price"
           type="number"
           min="0"
           max="999999.99"
           step="0.01"
           value="@PriceText"
           required />
</div>

<div class="form-field">
    <label>Currency *</label>

    <select name="Currency" required>
        @foreach (var currency in Currencies)
        {
            <option value="@currency"
                    selected="@(currency == SelectedCurrency)">
                @currency
            </option>
        }
    </select>
</div>

<h3>Participation Rules</h3>

<div class="form-field">
    <label>Duration</label>
    <input name="Duration"
           value="@Item?.Duration"
           maxlength="100"
           placeholder="2 hours, half day, 3 days..." />
</div>

<div class="form-field">
    <label>Maximum Participants *</label>

    <input name="MaxParticipants"
           value="@Item?.MaxParticipants"
           type="number"
           min="1"
           max="@ActivityCatalogRules.MaximumAllowedParticipants"
           step="1"
           required />

    <small>
        Maximum number of participants per reservation.
    </small>
</div>

<div class="form-field">
    <label>Minimum Age</label>
    <input name="MinimumAge"
           value="@Item?.MinimumAge"
           type="number"
           min="0"
           max="120"
           step="1" />
</div>

<div class="form-field">
    <label>Minimum Certification</label>
    <input name="MinimumCertification"
           value="@Item?.MinimumCertification"
           maxlength="200"
           placeholder="None, Open Water Diver, Advanced..." />
</div>

<div class="form-field">
    <label>Requires Boat *</label>

    <select name="RequiresBoat" required>
        <option value=""
                selected="@(Item is null)">
            Select boat requirement
        </option>

        <option value="false"
                selected="@(Item?.RequiresBoat == false)">
            No - Boat is optional
        </option>

        <option value="true"
                selected="@(Item?.RequiresBoat == true)">
            Yes - Boat assignment is mandatory
        </option>
    </select>
</div>

<h3>Additional Information</h3>

<div class="form-field">
    <label>Included in Price</label>
    <textarea name="Included"
              maxlength="2000"
              rows="4">@(Item?.Included ?? "")</textarea>
</div>

<div class="form-field">
    <label>Not Included in Price</label>
    <textarea name="NotIncluded"
              maxlength="2000"
              rows="4">@(Item?.NotIncluded ?? "")</textarea>
</div>

<div class="form-field">
    <label>Requirements</label>
    <textarea name="Requirements"
              maxlength="2000"
              rows="4">@(Item?.Requirements ?? "")</textarea>
</div>

@code {
    [Parameter]
    public ActivityCatalogItem? Item { get; set; }

    private string SelectedCurrency =>
        Item?.Currency ?? "EUR";

    private string PriceText =>
        (Item?.Price ?? 0m).ToString(
            "0.00",
            CultureInfo.InvariantCulture);

    private IEnumerable<string> Currencies =>
        new[] { "EUR", "USD", "GBP", "TRY", SelectedCurrency }
            .Distinct(StringComparer.OrdinalIgnoreCase);
}
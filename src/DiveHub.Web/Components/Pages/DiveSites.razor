
@page "/dive-sites"

@inject DiveHubApiClient Api
@inject DiveSitePhotoApiClient PhotoApi

<PageTitle>Dive Sites | Dive Hub</PageTitle>

<section class="page-header">
    <div class="container">

        <span class="eyebrow">
            UNDERWATER DESTINATIONS
        </span>

        <h1>Dive Sites</h1>

        <p>Explore our diving locations.</p>

    </div>
</section>

<section class="container section">

    @if (LoadError)
    {
        <div class="notice error">
            Dive sites could not be loaded.
        </div>
    }
    else if (Sites.Count == 0)
    {
        <div class="empty-state">
            <h2>No dive sites published yet.</h2>
            <p>
                New locations will appear here when published.
            </p>
        </div>
    }
    else
    {
        <div class="content-grid">

            @foreach (var site in Sites)
            {
                <article class="content-card">

                    @if (Photos.TryGetValue(
                        site.Id, out var photoList)
                        && photoList.Count > 0)
                    {
                        <div class="dive-photo-grid">

                            @foreach (var photo in photoList)
                            {
                                <img class="dive-photo"
                                     src="@($"/media/dive-sites/{site.Id}/{photo.Id}")"
                                     alt="@photo.AltText"
                                     loading="lazy" />
                            }

                        </div>
                    }

                    <span class="card-label">
                        DIVE SITE
                    </span>

                    <h2>@site.Name</h2>

                    <p>@site.Description</p>

                    @if (site.MaximumDepthMeters.HasValue)
                    {
                        <span class="card-meta">
                            Maximum depth:
                            @site.MaximumDepthMeters m
                        </span>
                    }

                </article>
            }

        </div>
    }

</section>

@code {
    private IReadOnlyList<DiveSite> Sites = [];

    private Dictionary<int, IReadOnlyList<DiveSitePhotoDto>>
        Photos = new();

    private bool LoadError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Sites = await Api.GetDiveSitesAsync();

            foreach (var site in Sites)
            {
                Photos[site.Id] =
                    await PhotoApi.GetPublicAsync(site.Id);
            }
        }
        catch (HttpRequestException)
        {
            LoadError = true;
        }
        catch (TaskCanceledException)
        {
            LoadError = true;
        }
    }
}
